<div class="container my-5">
    <div class="row">
        <div class="col text-center">
            <h1>Hola, {{usuario.nombre}}</h1>
            {{#if esAdmin}}
                <table class="table">
                    <tbody>
                    {{#each productos}}
                        <tr>
                            <td><img src="{{this.imagen}}" alt="{{this.nombre}}" width="80" class="me-3" /></td>
                            <td class="align-middle"><b>{{this.nombre}}</b></td>
                            <td class="align-middle">${{this.precio}}</td>
                        </tr>
                    {{/each}}
                    </tbody>
                </table>
            {{else}}
                <p class="text-center texto">No tenés los permisos para visualizar los Productos!</p>
                <p><button class="btn btn-dark text-white" onclick="saludar();">Saludar</button></p>
            {{/if}}
        </div>
    </div>
</div>
<script src="js/funciones.js"></script>