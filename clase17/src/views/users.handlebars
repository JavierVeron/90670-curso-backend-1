<div class="container my-5">
    <div class="row">
        <div class="col">
            <h1 class="display-6 text-center">Usuarios</h1>
            <table class="table table-striped">
                {{#each users.docs}}
                    <tr>
                        <td>{{this.nombre}}</td>
                        <td>{{this.apellido}}</td>
                        <td>{{this.email}}</td>
                        <td>{{this.genero}}</td>
                    </tr>
                {{/each}}
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="btn-group" role="group" aria-label="Basic example">
                <a href="/users?limit=20&page=1" class="btn btn-primary">1</a>
                <a href="/users?limit=20&page={users.prevPage}" class="btn btn-primary">{{users.prevPage}}</a>
                <a href="#" class="btn btn-primary">{{users.page}}</a>
                <a href="/users?limit=20&page={users.nextPage}" class="btn btn-primary">{{users.nextPage}}</a>
                <a href={{users.totalPages}} class="btn btn-primary">{{users.totalPages}}</a>
            </div>
        </div>
    </div>
</div>